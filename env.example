# Google OAuth web/server credentials. Gmail access must be READ-ONLY.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Supabase server-only credentials. Never expose the secret key in browser code.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=

# Random server secret used by Vercel Cron authorization.
CRON_SECRET=
